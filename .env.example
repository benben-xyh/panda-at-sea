# ===== 复制为 .env 并修改（生产必须改 JWT_SECRET）=====
# 生成强密钥：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-me

# 短信（生产）：先完成腾讯云实名审核（签名/模板），再切 tencent
SMS_MODE=console
